//@version=5
indicator("Nifty Top 10 Stocks Table & Breadth", overlay=true)

// === Inputs: Symbols and Weights ===
group_1 = "Stock 1"
s0 = input.symbol("NSE:RELIANCE", "Symbol", group=group_1)
w0 = input.float(9.12, "Weight (%)", group=group_1)

group_2 = "Stock 2"
s1 = input.symbol("NSE:HDFCBANK", "Symbol", group=group_2)
w1 = input.float(8.08, "Weight (%)", group=group_2)

group_3 = "Stock 3"
s2 = input.symbol("NSE:ICICIBANK", "Symbol", group=group_3)
w2 = input.float(7.96, "Weight (%)", group=group_3)

group_4 = "Stock 4"
s3 = input.symbol("NSE:INFY", "Symbol", group=group_4)
w3 = input.float(5.71, "Weight (%)", group=group_4)

group_5 = "Stock 5"
s4 = input.symbol("NSE:TCS", "Symbol", group=group_5)
w4 = input.float(4.28, "Weight (%)", group=group_5)

group_6 = "Stock 6"
s5 = input.symbol("NSE:ITC", "Symbol", group=group_6)
w5 = input.float(4.19, "Weight (%)", group=group_6)

group_7 = "Stock 7"
s6 = input.symbol("NSE:LT", "Symbol", group=group_7)
w6 = input.float(4.11, "Weight (%)", group=group_7)

group_8 = "Stock 8"
s7 = input.symbol("NSE:SBIN", "Symbol", group=group_8)
w7 = input.float(3.48, "Weight (%)", group=group_8)

group_9 = "Stock 9"
s8 = input.symbol("NSE:BHARTIARTL", "Symbol", group=group_9)
w8 = input.float(3.32, "Weight (%)", group=group_9)

group_10 = "Stock 10"
s9 = input.symbol("NSE:AXISBANK", "Symbol", group=group_10)
w9 = input.float(3.31, "Weight (%)", group=group_10)

// === Helper functions ===
f_get_text(val) => na(val) ? "N/A" : str.tostring(val, format.percent)
f_get_color(val) => na(val) ? color.gray : (val >= 0 ? color.green : color.red)

// === Fetch data for each symbol ===
getData(sym) =>
    [d_c, d_pc, d_o] = request.security(sym, "D", [close, close[1], open], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    h_pc = request.security(sym, "60", close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    [d_c, d_pc, d_o, h_pc]

[c0, p0, o0, h0] = getData(s0)
[c1, p1, o1, h1] = getData(s1)
[c2, p2, o2, h2] = getData(s2)
[c3, p3, o3, h3] = getData(s3)
[c4, p4, o4, h4] = getData(s4)
[c5, p5, o5, h5] = getData(s5)
[c6, p6, o6, h6] = getData(s6)
[c7, p7, o7, h7] = getData(s7)
[c8, p8, o8, h8] = getData(s8)
[c9, p9, o9, h9] = getData(s9)

// === Store data in arrays ===
symbols = array.from(s0, s1, s2, s3, s4, s5, s6, s7, s8, s9)
prices = array.from(c0, c1, c2, c3, c4, c5, c6, c7, c8, c9)
prev_closes = array.from(p0, p1, p2, p3, p4, p5, p6, p7, p8, p9)
opens = array.from(o0, o1, o2, o3, o4, o5, o6, o7, o8, o9)
hourly_prev_closes = array.from(h0, h1, h2, h3, h4, h5, h6, h7, h8, h9)

// === Breadth Calculation (80% rule) ===
float pos_count = 0
float neg_count = 0

for i = 0 to 9
    price_today = array.get(prices, i)
    price_yday = array.get(prev_closes, i)
    if not na(price_today) and not na(price_yday)
        if price_today > price_yday
            pos_count += 1
        else if price_today < price_yday
            neg_count += 1

is_80_pos = pos_count >= 8
is_80_neg = neg_count >= 8

// Plot arrows on chart
plotshape(is_80_pos, "80% Positive Breadth", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(is_80_neg, "80% Negative Breadth", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)

// === Create table ===
// Compact table: Symbol, % Chg (Day), % Chg (Open), % Chg (1H)
var table t = table.new(position.top_right, 4, 11, border_width = 1, border_color = color.gray)

// === Update table on the last bar ===
if barstate.islast
    // Header colors
    header_bg = color.blue
    header_text = color.white
    // Body colors
    body_bg = color.new(color.black, 10)
    body_text = color.white
    t_size = size.small

    // Header
    table.cell(t, 0, 0, "Symbol", text_color=header_text, bgcolor=header_bg, text_size=t_size)
    table.cell(t, 1, 0, "% Chg (Day)", text_color=header_text, bgcolor=header_bg, text_size=t_size)
    table.cell(t, 2, 0, "% Chg (Open)", text_color=header_text, bgcolor=header_bg, text_size=t_size)
    table.cell(t, 3, 0, "% Chg (1H)", text_color=header_text, bgcolor=header_bg, text_size=t_size)

    // Loop through stocks and fill table
    for i = 0 to 9
        sym = array.get(symbols, i)
        curr_price = array.get(prices, i)

        // 1. % Change from Previous Day
        yday_price = array.get(prev_closes, i)
        chg_day = not na(curr_price) and not na(yday_price) and yday_price != 0 ? (curr_price - yday_price) / yday_price : na

        // 2. % Change from Open
        open_price = array.get(opens, i)
        chg_open = not na(curr_price) and not na(open_price) and open_price != 0 ? (curr_price - open_price) / open_price : na

        // 3. Hourly % Change
        hour_ago_price = array.get(hourly_prev_closes, i)
        chg_hour = not na(curr_price) and not na(hour_ago_price) and hour_ago_price != 0 ? (curr_price - hour_ago_price) / hour_ago_price : na

        // Fill table cells
        table.cell(t, 0, i+1, str.replace(sym, "NSE:", ""), text_color=body_text, bgcolor=body_bg, text_size=t_size)
        table.cell(t, 1, i+1, f_get_text(chg_day), text_color = f_get_color(chg_day), bgcolor=body_bg, text_size=t_size)
        table.cell(t, 2, i+1, f_get_text(chg_open), text_color = f_get_color(chg_open), bgcolor=body_bg, text_size=t_size)
        table.cell(t, 3, i+1, f_get_text(chg_hour), text_color = f_get_color(chg_hour), bgcolor=body_bg, text_size=t_size)
